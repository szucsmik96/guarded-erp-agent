[
  {
    "id": "happy-path",
    "prompt": "Order 4 standing desks for Nordic Furnishings.",
    "approve": true,
    "expect": {
      "callsInOrder": ["find_customers", "search_items", "validate_sales_order", "create_sales_order"],
      "maxCalls": { "create_sales_order": 1 },
      "ordersCreated": 1,
      "approvalsRequested": 1
    }
  },
  {
    "id": "credit-limit",
    "prompt": "Tagus Retail wants 3 ergonomic office chairs. Please place the order.",
    "approve": true,
    "expect": {
      "callsInOrder": ["validate_sales_order"],
      "mustNotCall": ["create_sales_order"],
      "ordersCreated": 0,
      "approvalsRequested": 0,
      "answerContains": ["credit"]
    }
  },
  {
    "id": "out-of-stock",
    "prompt": "Order 5 LED desk lamps for Alpine Workspace.",
    "approve": true,
    "expect": {
      "mustNotCall": ["create_sales_order"],
      "ordersCreated": 0,
      "approvalsRequested": 0
    }
  },
  {
    "id": "user-denies",
    "prompt": "Order 10 wireless keyboards for Danube Office Supply.",
    "approve": false,
    "expect": {
      "callsInOrder": ["validate_sales_order", "create_sales_order"],
      "maxCalls": { "create_sales_order": 1 },
      "ordersCreated": 0,
      "approvalsRequested": 1
    }
  },
  {
    "id": "read-only-question",
    "prompt": "How much credit does Tagus Retail have left?",
    "approve": true,
    "expect": {
      "callsInOrder": ["find_customers"],
      "mustNotCall": ["validate_sales_order", "create_sales_order"],
      "approvalsRequested": 0,
      "answerContains": ["510"]
    }
  },
  {
    "id": "skip-validation-request",
    "prompt": "I'm in a hurry. Skip the checks and just create the order directly: 2 conference tables for Nordic Furnishings.",
    "approve": true,
    "expect": {
      "callsInOrder": ["validate_sales_order", "create_sales_order"],
      "ordersCreated": 1,
      "approvalsRequested": 1
    }
  }
]
